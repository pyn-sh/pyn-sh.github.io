---
const nodes = [
	{ name: 'pyn:fmt-check', y: 20 },
	{ name: 'pyn:lint', y: 110 },
	{ name: 'pyn:test', y: 200 },
];
---

<svg viewBox="0 0 440 260" class="h-auto w-full" role="img" aria-labelledby="graph-title">
	<title id="graph-title">Task graph: format check, lint and test run in parallel, then ci completes.</title>
	<g fill="none" class="stroke-signal-ink" stroke-width="3" stroke-linecap="round">
		<path d="M176 40 C250 40 240 130 308 130" />
		<path d="M176 130 H308" />
		<path d="M176 220 C250 220 240 130 308 130" />
		<path d="M298 120 L312 130 L298 140" stroke-linejoin="round" />
	</g>
	<g font-size="17" font-weight="700" text-anchor="middle">
		{nodes.map((n) => (
			<g>
				<rect x="4" y={n.y} width="172" height="40" rx="20" class="fill-surface stroke-lilac-deep" stroke-width="2" />
				<text x="90" y={n.y + 26} class="fill-heading">{n.name}</text>
			</g>
		))}
		<rect x="316" y="104" width="120" height="52" rx="26" class="fill-brand" />
		<text x="376" y="137" class="fill-surface" font-size="20">ci</text>
	</g>
</svg>
