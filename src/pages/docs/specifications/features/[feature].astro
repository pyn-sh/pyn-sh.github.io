---
import type { GetStaticPaths } from 'astro';
import { Code } from 'astro:components';
import Docs from '../../../../layouts/Docs.astro';
import { features } from '../../../../lib/docs';

export const getStaticPaths = (() =>
	features().map((feature) => ({ params: { feature: feature.slug }, props: { feature } }))) satisfies GetStaticPaths;

const { feature } = Astro.props;
---

<Docs title={feature.title} source={`specifications/features/${feature.slug}.feature`}>
	<h1>{feature.title}</h1>
	<p>Draft behavior specification. It has no step definitions yet, so it has never been executed.</p>
	<Code code={feature.source} lang="gherkin" theme="github-light-high-contrast" />
</Docs>
