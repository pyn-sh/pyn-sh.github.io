---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Pyn" description="This page does not exist.">
	<section class="shell py-24">
		<h1 class="text-4xl font-extrabold tracking-[-0.03em] text-heading sm:text-6xl">That page does not exist.</h1>
		<p class="mt-5 text-lg text-muted">It may have moved when the documents changed.</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a href="/docs/" class="button bg-brand text-surface hover:bg-brand-strong">Browse the documentation</a>
			<a href="/" class="button border-2 border-line text-heading hover:bg-surface">Go to the home page</a>
		</div>
	</section>
</Base>
